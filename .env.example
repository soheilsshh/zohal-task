# Copy this file to .env. The process reads .env at startup.
# Environment variables win over this file. Defaults in code win if both are absent.
# Phase 3 calls PROVIDER_A_URL first. A timeout, connect error, 429, 502, 503, or 504
# may try B or C once, inside DEADLINE_SECONDS (default 3).
# Timeouts have defaults in app/settings.py. Override with, for example:
# PROVIDER_A_READ_TIMEOUT_SECONDS=1.5
# Redis, the bucket, and the inbound window also have defaults.
# REDIS_URL=redis://redis:6379/0
# PROVIDER_A_BUCKET_CAPACITY=20
# PROVIDER_A_REFILL_PER_SECOND=10
# INBOUND_LIMIT=100
# INBOUND_WINDOW_SECONDS=1
# IDEMPOTENCY_TTL_SECONDS=86400

PROVIDER_A_URL=http://92.114.51.251:8001/v1/process
PROVIDER_B_URL=http://92.114.51.251:8002/v1/process
PROVIDER_C_URL=http://92.114.51.251:8003/v1/process
